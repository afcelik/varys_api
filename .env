# Application
APP_NAME="Varys API"
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=test-secret-key-for-development-only-32chars

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Database (placeholder for future)
# DATABASE_URL=sqlite:///./varys.db

# AI Provider (NVIDIA)
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Notifications (ntfy)
# NTFY_URL=https://ntfy.yourdomain.com
# NTFY_TOPIC=varys-notifications